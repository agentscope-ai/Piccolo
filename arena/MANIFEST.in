include requirements.txt Dockerfile compose.yaml
include .dockerignore .gitignore
recursive-include web *.html *.css *.js *.cjs *.ttf *.woff *.woff2 *.svg *.ico *.txt *.json *.png *.jpg *.jpeg *.gif *.mp4 *.webm LICENSE
recursive-include config *.json
recursive-include data/seed *.json *.jsonl *.gz
recursive-include leaderboard *.json
exclude leaderboard/arena.json leaderboard/arena-elo.json leaderboard/arena-independent.json leaderboard/arena-ratings.json leaderboard/arena-replays.json
exclude web/playground/elo.js web/playground/elo.css web/playground/arena-independent.js web/playground/visible-control.js web/playground/replay.js web/playground/replay.css
prune leaderboard/history
recursive-include docs *.md *.json *.txt
exclude docs/ENGINE_INTEGRATION_HANDOFF.md
recursive-include deploy *
recursive-include scripts *.sh *.py *.mjs
recursive-include tests *.py *.cjs
prune var
prune .venv
prune .git
prune venv
prune build
prune dist
prune .pytest_cache
global-exclude __pycache__ *.py[cod] .DS_Store
global-exclude .env .env.* *.log *.pem *.key *.p12 *.pfx *.sqlite* *.db
exclude docs/HANDOFF_ACK.md
